# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Homebrew environment
if [ -x "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# PATH configuration
for p in "$HOME/.local/bin" "$HOME/.local/share/vite-plus/bin"; do
  if [[ -d "$p" && ":$PATH:" != *":$p:"* ]]; then
    PATH="$p:$PATH"
  fi
done
export PATH

# Vite+ environment setup
if [ -f "$HOME/.config/vite-plus/env" ]; then
  . "$HOME/.config/vite-plus/env"
fi

# Aliases
alias nr="npm run"
alias la="ls -lah"
alias ll="ls -lh"

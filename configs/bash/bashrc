# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Homebrew environment
if [ -x "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# PATH configuration
for p in "$HOME/.local/bin" "$HOME/.local/opt/node/bin"; do
  if [[ -d "$p" && ":$PATH:" != *":$p:"* ]]; then
    PATH="$p:$PATH"
  fi
done
export PATH

# Aliases
alias nr="npm run"
alias la="ls -lah"
alias ll="ls -lh"

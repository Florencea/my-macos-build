#compdef mkclp

local -a qualities
qualities=(
  '45:Sweet Spot (Storage-optimized, ~41% reduction)'
  '50:Sweet Spot (Quality-optimized, ~29% reduction)'
  '25:Low-bandwidth mobile playback'
  '40:Standard playback'
  '60:High quality (larger size)'
)

_arguments -s \
  '1:Input Video (File or URL):_alternative "files:Video Files:_files -g \"*.(mp4|mkv|mov|webm|avi|ts)(-.)\"" "urls:URL:(https\:// http\://)" "allfiles:All Files:_files"' \
  '2:Start Time (HH:MM:SS or SS): ' \
  '3:Duration (Seconds or End Time): ' \
  '4:Quality (0-100):_describe -t qualities "Quality Preset" qualities' \
  '5:Output File:_files'

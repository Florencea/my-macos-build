# Disable Apple Terminal session persistence to prevent ~/.zsh_sessions overhead
export SHELL_SESSIONS_DISABLE=1

# Homebrew environment (only if not already initialized by login shell)
if [[ -z "${HOMEBREW_PREFIX:-}" && -x "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Ensure unique entries in PATH
typeset -U path PATH

# PATH configuration
path=(
  "$HOME/.local/bin"
  "$HOME/.local/opt/node/bin"
  $path
)
export PATH

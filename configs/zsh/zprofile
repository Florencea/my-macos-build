# Homebrew environment
if [[ -x "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Ensure unique entries in PATH
typeset -U path PATH

# PATH configuration
path=(
  "$HOME/.local/bin"
  $path
)
if [[ -d "$HOME/go/bin" ]]; then
  path+=("$HOME/go/bin")
fi
export PATH

#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

# Description: Upgrade Homebrew formulas, update Node.js (via fnm), and sync all git repositories in workspace
# Usage: ua
# Example: ua

# 1. Check required tools
for cmd in brew fnm git node; do
  command -v "$cmd" &>/dev/null || {
    echo "Error: $cmd is not installed" >&2
    exit 1
  }
done

# 2. Upgrade Homebrew packages
cd "$HOME"
# Disable greedy upgrades to prevent updating auto-updating apps (e.g. microsoft-edge)
HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_NO_ASK=1 HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1 brew upgrade
HOMEBREW_NO_ENV_HINTS=1 brew cleanup

# 3. Update Node.js via fnm
NODE_VERSION="24"

if REMOTE_VERSION="$(fnm list-remote --filter "${NODE_VERSION#v}" --latest 2>/dev/null)" && [[ -n "$REMOTE_VERSION" ]]; then
  # Strip LTS nickname (e.g. "v24.16.0 (Krypton)" -> "v24.16.0")
  REMOTE_VERSION="${REMOTE_VERSION%% *}"
  CURRENT_VERSION="$(node -v 2>/dev/null || echo "")"

  if [[ "$REMOTE_VERSION" != "$CURRENT_VERSION" ]]; then
    printf "Updating Node.js: local %s -> remote %s (target: %s)\n" \
      "${CURRENT_VERSION:-none}" "$REMOTE_VERSION" "$NODE_VERSION"
    fnm install "$REMOTE_VERSION" &>/dev/null
    fnm default "$REMOTE_VERSION" &>/dev/null
    [[ -n "$CURRENT_VERSION" ]] && fnm uninstall "$CURRENT_VERSION" &>/dev/null
    CURRENT_VERSION="$REMOTE_VERSION"
    NPM_VERSION="$(fnm exec --using="$REMOTE_VERSION" npm -v 2>/dev/null || echo "n/a")"
  else
    NPM_VERSION="$(npm -v 2>/dev/null || echo "n/a")"
  fi
else
  printf "Warning: Failed to fetch remote Node.js version for %s. Skipping Node.js update.\n" "$NODE_VERSION" >&2
  CURRENT_VERSION="$(node -v 2>/dev/null || echo "")"
  NPM_VERSION="$(npm -v 2>/dev/null || echo "n/a")"
fi

# 4. Print active Node.js and npm versions
printf "\nnode: %s, npm: %s\n\n" "$CURRENT_VERSION" "$NPM_VERSION"

# 5. Sync git projects in workspace
SCRIPT_PATH="$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")"
PROJECTS_DIR="$(cd "$SCRIPT_PATH/../.." && pwd)"

if cd "$PROJECTS_DIR"; then
  for PROJECT in */; do
    [[ -d "$PROJECT" ]] || continue
    PROJECT="${PROJECT%/}"
    if [[ -d "$PROJECT/.git" ]]; then
      git -C "$PROJECT" pull --all --quiet && printf "Sync %s ok\n" "$PROJECT" &
    fi
  done
  wait
fi

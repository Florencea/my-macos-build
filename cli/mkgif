#! /usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

# Description: High-quality Gif Maker via gifski (Supports -w/--width, --fps, -q/--quality, -l/--lossy, local files and YouTube)
# Usage: mkgif [-w 720] [--fps 10] [-q 70] [-l] [input_file_or_url] [from(hh:mm:ss or sec)] [during(sec)]
# Example: mkgif 'input.mp4' 01:02:08 11.0
#          mkgif JoSY6AWKqHs 00:01:59 20 --fps 10 -w 720

### Args
FPS=10
WIDTH=720
QUALITY=70
LOSSY=false
TEMP_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --fps)
    if [[ $# -lt 2 ]]; then
      echo "Error: --fps requires a value" >&2
      exit 1
    fi
    FPS="$2"
    shift 2
    ;;
  -w | --width)
    if [[ $# -lt 2 ]]; then
      echo "Error: -w/--width requires a value" >&2
      exit 1
    fi
    WIDTH="$2"
    shift 2
    ;;
  -q | --quality)
    if [[ $# -lt 2 ]]; then
      echo "Error: -q/--quality requires a value" >&2
      exit 1
    fi
    QUALITY="$2"
    shift 2
    ;;
  -l | --lossy)
    LOSSY=true
    shift 1
    ;;
  *)
    TEMP_ARGS+=("$1")
    shift 1
    ;;
  esac
done

# Restore positional parameters
set -- "${TEMP_ARGS[@]}"

INPUT_FILE=${1:-}
START=${2:-}
DURATION=${3:-}

# Check arguments
if [[ -z "$DURATION" ]]; then
  echo "mkgif: High-quality Gif Maker via gifski" >&2
  echo "Usage: mkgif [-w 720] [--fps 10] [-q 70] [-l] [input_file_or_url] [from(hh:mm:ss or sec)] [during(sec)]" >&2
  echo "       mkgif 'input.mp4' 01:02:08 11.0" >&2
  echo "       mkgif JoSY6AWKqHs 00:01:59 20 --fps 10 -w 720" >&2
  exit 1
fi

# Check commands
command -v ffmpeg &>/dev/null || {
  echo "ffmpeg is not installed" >&2
  exit 1
}
command -v gifski &>/dev/null || {
  echo "gifski is not installed" >&2
  exit 1
}

IS_YT=false
INPUT_SOURCE="$INPUT_FILE"

# Check if input exists as a file; if not, treat as YouTube source
if [[ ! -f "$INPUT_FILE" ]]; then
  command -v yt-dlp &>/dev/null || {
    echo "File $INPUT_FILE not exist and yt-dlp is not installed" >&2
    exit 1
  }
  IS_YT=true
fi

if [ "$IS_YT" = true ]; then
  BROWSER="${YT_DLP_BROWSER:-chrome}"
  # Dynamically determine target video height based on requested width
  # (e.g. width >= 1280 fetches up to 1080p/4K source for high-quality downsampling)
  if ((WIDTH <= 480)); then
    YT_HEIGHT=480
  elif ((WIDTH <= 720)); then
    YT_HEIGHT=720
  elif ((WIDTH <= 1280)); then
    YT_HEIGHT=1080
  else
    YT_HEIGHT=2160
  fi

  YT_FORMAT="bestvideo[height<=${YT_HEIGHT}]/best[height<=${YT_HEIGHT}]/bestvideo/best"
  STREAM_URL=$(yt-dlp --cookies-from-browser "$BROWSER" -g -f "$YT_FORMAT" "$INPUT_FILE" 2>/dev/null || true)
  if [[ -z "$STREAM_URL" ]]; then
    STREAM_URL=$(yt-dlp -g -f "$YT_FORMAT" "$INPUT_FILE" 2>/dev/null || true)
  fi
  if [[ -z "$STREAM_URL" ]]; then
    echo "Failed to get stream URL from yt-dlp for input: $INPUT_FILE" >&2
    exit 1
  fi
  INPUT_SOURCE="$STREAM_URL"
fi

### Output file
OUTPUT_FILE="$(date +"%Y%m%d%H%M%S")_fps${FPS}.gif"

# Explicitly pass -W $WIDTH to prevent gifski from silently clamping to 800x600
GIFSKI_ARGS=("-q" "-Q" "$QUALITY" "-W" "$WIDTH")
if [ "$LOSSY" = true ]; then
  GIFSKI_ARGS+=("--lossy-quality" "75")
fi

ffmpeg -y -hide_banner \
  -loglevel error \
  -ss "$START" \
  -i "$INPUT_SOURCE" \
  -t "$DURATION" \
  -vf "fps=$FPS,scale=$WIDTH:-2:flags=lanczos,format=yuv420p" \
  -f yuv4mpegpipe - |
  gifski "${GIFSKI_ARGS[@]}" \
    -o "$OUTPUT_FILE" -

printf "%s " "$OUTPUT_FILE"
ls -lh "$OUTPUT_FILE" | awk -F " " {'print $5'}

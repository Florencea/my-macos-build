#! /usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

# Description: Sync and update Node.js version in package.json engines.node for all local workspace projects
# Usage: unodev
# Example: unodev

# Check commands
for cmd in git node jq; do
  command -v "$cmd" &>/dev/null || {
    echo "$cmd is not installed" >&2
    exit 1
  }
done

# Print current node version
CURRENT_LOCAL_VERSION="$(node -v)"
printf "\nnode: %s\n\n" "$CURRENT_LOCAL_VERSION"

# Extract raw active node version once
NODE_VERSION="${CURRENT_LOCAL_VERSION#v}"

# Define workspace directories referencing cli/ua
SCRIPT_PATH="$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")"
PROJECTS_DIR="$(cd "$SCRIPT_PATH/../.." && pwd)"

if cd "$PROJECTS_DIR"; then
  for PROJECT in */; do
    [[ -d "$PROJECT" ]] || continue
    PROJECT="${PROJECT%/}"

    # Skip hidden folders
    [[ "$PROJECT" == .* ]] && continue

    if [[ -d "$PROJECT/.git" && -f "$PROJECT/package.json" ]]; then
      OLD_NODE_VERSION="$(jq -r '.engines.node // empty' "$PROJECT/package.json" 2>/dev/null || true)"

      if [[ "$OLD_NODE_VERSION" != "$NODE_VERSION" ]]; then
        (
          cd "$PROJECT"
          jq --arg v "$NODE_VERSION" '.engines.node = $v' package.json > package.json.tmp && mv package.json.tmp package.json

          if [[ -n "$(git status --short package.json)" ]]; then
            git add package.json
            if git commit -q -m "chore(node): Update engines.node $OLD_NODE_VERSION -> $NODE_VERSION"; then
              if git push -q &>/dev/null; then
                printf "engines.node %s: %s -> %s ok\n" "$PROJECT" "$OLD_NODE_VERSION" "$NODE_VERSION"
              else
                printf "engines.node %s: failed to push\n" "$PROJECT" >&2
              fi
            fi
          fi
        ) &
      else
        printf "engines.node %s: %s ok\n" "$PROJECT" "$OLD_NODE_VERSION"
      fi
    fi
  done
  wait
fi

{
  "name": "my-machine-build",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:test:unit": "vp test run --project unit --reporter=tap-flat --no-color",
    "agent:verify:gate": "vpr agent:verify:unit && vp test run --project contract --reporter=tap-flat --no-color && vpr verify:native",
    "agent:verify:inner": "vpr typecheck && vp check",
    "agent:verify:unit": "vpr agent:verify:inner && vpr agent:test:unit",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "defuddle": "0.19.6",
    "linkedom": "0.18.15",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/turndown": "5.0.6",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0"
  },
  "engines": {
    "node": "26.13.1"
  }
}
